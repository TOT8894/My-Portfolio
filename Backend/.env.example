# Production Environment Variables Example
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://api.your-domain.com

# PostgreSQL Database Connection URL (Prisma 6)
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# Dual-Token JWT Secrets (Generate secure 64-char random strings in production)
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_characters
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters
JWT_REFRESH_EXPIRATION=7d

# Nodemailer SMTP Configuration for Email Inquiries
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shanbel.dires@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="Shanbel Dires Portfolio" <shanbel.dires@gmail.com>
EMAIL_TO=shanbel.dires@gmail.com

# Cloudinary Storage Configuration for Portfolio Media
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
